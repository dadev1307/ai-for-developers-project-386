#!/bin/sh
# Запрет прямых пушей в main: изменения проходят только через PR (см. AGENTS.md).
while read local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "pre-push: пуш в 'main' запрещён — создайте фича-ветку и PR (AGENTS.md)" >&2
    exit 1
  fi
done
exit 0
